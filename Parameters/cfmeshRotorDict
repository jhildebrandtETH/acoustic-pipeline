FoamFile { version 2.0; format ascii; class dictionary; object meshDict; }
#include "cfmeshSizes.cpp"
#include "cfmeshGlobalDict"
surfaceFile "constant/triSurface/domain.ftr";
maxCellSize $backgroundCellSize;
edgeMeshRefinement
{
    #includeIfPresent "cfmeshFeatures.generated"
}
localRefinement
{
    // Outer distance band is applied in the boundary-refinement pass.
    propeller
    {
        additionalRefinementLevels $propellerLevel;
        refinementThickness $propellerRefinementThickness;
    }
    "rotaryRegion_.*" { additionalRefinementLevels $interfaceLevel; }
}

// Inner distance band is applied in a separate surface-refinement pass.
// Do not put both bands in surfaceMeshRefinement: cfMesh combines the maximum
// thickness of coincident surfaces with the finer level during that pass.
// Both distances start at the propeller wall; transitions remain cell-sized.
surfaceMeshRefinement
{
    propellerNear
    {
        surfaceFile "constant/triSurface/propeller.stl";
        additionalRefinementLevels $propellerNearLevel;
        refinementThickness $propellerNearRefinementThickness;
    }
}

// Complete native cfMesh workflow: generate and refine propeller boundary layers.
// For a no-layer comparison add: workflowControls { stopAfter edgeExtraction; }
// cfMesh also inserts its automatic base layer on the rotor interface.
boundaryLayers
{
    optimiseLayer $layerOptimise;
    untangleLayers $layerUntangle;
    optimisationParameters
    {
        nSmoothNormals $layerSmoothNormalsIterations;
        maxNumIterations $layerMaxIterations;
        featureSizeFactor $layerFeatureSizeFactor;
        recalculateNormals $layerRecalculateNormals;
        relThicknessTol $layerRelativeThicknessTolerance;
    }
    patchBoundaryLayers
    {
        propeller
        {
            nLayers $propellerLayerCount;
            thicknessRatio $propellerLayerThicknessRatio;
            maxFirstLayerThickness $propellerMaxFirstLayerThickness;
            allowDiscontinuity $propellerLayerAllowDiscontinuity;
        }
    }
}

// Generated from cfmeshDomainDict, cfmeshRefinementDict and cfmeshCommon.cpp.
// The same region definitions are used on both sides of the rotating interface.
objectRefinements
{
    #includeIfPresent "cfmeshRegions.generated"
}
