FoamFile { version 2.0; format ascii; class dictionary; object cfmeshPipelineDict; }
// Pipeline controls, not native cartesianMesh entries. See cfmeshGuide.md.
// Extra mesh improvement applies to both rotor and stator in this variant.
improveMeshQuality
{
    // Each pass runs after its region's cartesianMesh, including completed layers.
    rotor
    {
        enabled true;
        nLoops 6;
        nIterations 20;
        nSurfaceIterations 0;
    }
    stator
    {
        enabled true;
        nLoops 2;
        nIterations 20;
        nSurfaceIterations 0;
    }
}
interfaceProjection
{
    enabled false;          // Project both interface patches onto the same cylinder.
    movementLimitFactor 3.0; //1.5 // Multiplier on the polygon chord-to-circle error.
    absoluteTolerance 1e-10; // Additional allowed movement, metres.
}
acceptance
{
    maxRelativeVolumeError 0.005; // Fraction: 0.005 = 0.5%.
    minimumFaceCoverage 0.95;
    minimumAverageCoverage 0.999;
}
