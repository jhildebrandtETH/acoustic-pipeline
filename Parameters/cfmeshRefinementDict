FoamFile { version 2.0; format ascii; class dictionary; object cfmeshRefinementDict; }
// Refinement dimensions relative to the same sphere used for domain sizing.
// R = 0.5 * sphereDiameterFactor * measured propeller span.
// In permeable mode --acoustic-sphere-diameter replaces sphereDiameterFactor.
enabled true;
sphereDiameterFactor 2.5;
wakeOffsetFactor -0.12; // Refinement cylinder centres: Y = factor*R (toward outlet).
// This shifts refinement cylinders, not the sphere or domain. The domain's
// upstream/downstream allocation is controlled by cfmeshDomainDict/inletFraction.
innerRadiusFactor 0.6;
innerHeightFactor 0.52;
outerRadiusFactor 0.8;
outerHeightFactor 0.72;
sphereSubdivisions 6;
