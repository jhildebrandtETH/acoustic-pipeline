FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.06;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

	farfield
	{
		type            inletOutlet;
        inletValue      uniform 1e-10;
        value           uniform 1e-10;
	}

    cubeWall
    {
        type            fixedValue;
        value           uniform 1e-12;
    }

    rotorAMI
    {
    type    zeroGradient;
    }

    statorAMI
    {
    type    zeroGradient;
    }
}


