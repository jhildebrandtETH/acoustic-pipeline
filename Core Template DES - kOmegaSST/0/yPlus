FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      yPlus;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0;

boundaryField
{
    "inlet|outlet|walls"
    {
        type            calculated;
        value           uniform 0;
    }
    rotaryRegion_slave
    {
        type            calculated;
        value           uniform 0;
    }
    rotaryRegion
    {
        type            calculated;
        value           uniform 0;
    }
    propeller
    {
        type            calculated;
        value           uniform 0;
    }
}


