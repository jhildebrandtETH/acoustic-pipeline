FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 0.0495;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
	
	walls
	{
		type            fixedValue;
        value           uniform 1000;
	}

    rotaryRegion
    {
    type    zeroGradient;
    }

    rotaryRegion_slave
    {
    type    zeroGradient;
    }

    propeller
    {
        type            omegaWallFunction;
        value           uniform 1;
    }
}


