FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      wallShearStress;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    "inlet|outlet|walls"
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    
    rotaryRegion
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    rotaryRegion_slave
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    propeller
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}


