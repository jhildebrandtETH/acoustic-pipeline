FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      yPlus;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0;

boundaryField
{
    farfield
    {
        type            calculated;
        value           uniform 0;
    }
    statorami
    {
        type            calculated;
        value           uniform 0;
    }
    rotorami
    {
        type            calculated;
        value           uniform 0;
    }
    cubewall
    {
        type            calculated;
        value           uniform 0;
    }
}


